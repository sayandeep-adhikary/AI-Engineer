# Firebase Web configuration for Epoch.
#
# These are PUBLIC client identifiers (safe to expose in a web bundle), but they
# are kept environment-driven so the repository is not tied to one project and
# no real values are committed. Copy this file to `.env` and fill in the values
# from your Firebase project settings (Project settings → General → Your apps).
#
# Epoch runs fully in LOCAL MODE (no authentication, local progress only) when
# these are absent, so the app still works without a Firebase project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
