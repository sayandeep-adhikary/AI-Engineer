rules_version = '2';

// Epoch Firestore security rules.
// Principle: a signed-in user may read and write ONLY their own user document.
// There are no public documents and no open access.
service cloud.firestore {
  match /databases/{database}/documents {

    // Account metadata only: users/{uid}. No progress data lives here.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile();
      allow update: if isOwner(userId) && isValidProfile();
      allow delete: if false; // profiles are not client-deletable

      // Cloud progress: users/{uid}/progress/{docId}. Owner-only, versioned doc.
      match /progress/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidProgressDoc();
        allow delete: if isOwner(userId);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Keep the document shape to known account-metadata fields only.
    function isValidProfile() {
      let allowed = ['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'];
      return request.resource.data.keys().hasOnly(allowed);
    }

    // Progress doc must carry only known top-level keys (progress payload is opaque).
    function isValidProgressDoc() {
      let allowed = ['schemaVersion', 'progressVersion', 'progress', 'updatedAt'];
      return request.resource.data.keys().hasOnly(allowed)
        && request.resource.data.schemaVersion is int;
    }
  }
}
